CERTWATCH_IMAGE=ghcr.io/YOUR_GITHUB_USERNAME/certwatch:latest
# 127.0.0.1 is safest for a local reverse proxy; use a trusted interface IP for remote access.
CERTWATCH_BIND_ADDRESS=127.0.0.1
CERTWATCH_PORT=8080
CERTWATCH_SCAN_INTERVAL_HOURS=24
CERTWATCH_TIMEOUT_SECONDS=10
# JSON string; set in Portainer Stack environment (not in public Git).
CERTWATCH_ENDPOINTS_JSON={"endpoints":[{"name":"Example","host":"example.com","port":443,"environment":"test","service":"https","enabled":true}]}
